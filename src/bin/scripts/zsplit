	print "Parsing the objects ... ";

	while( $OUTPUT_ACTIVE == 1 ) {
	}

} # parse_objects

#
# World Parser
#
sub parse_world{
	local( $WORLD_STATEMENTS ) = 0;

	while( $OUTPUT_ACTIVE == 1 ) {

		$ROOM_NUMBER = -1;

		do {
			if( !/^#\d/ ){ $_ = <STDIN>; }

			if( /$EOF_STR|^#99999/ ){ $ROOM_NUMBER = $OUTPUT_ACTIVE = 0; print OUTFILE $NEW_EOF; close OUTFILE; last; }

			elsif( /^#/ ){
				( $ROOM_NUMBER ) = /^#(\d+)/;
				$WORLD_STATEMENTS += 1;
			}
		} while( $ROOM_NUMBER < 0 );

		$THIS_ROOM = &adjust_id( "World Room", $ROOM_NUMBER );

		$ROOM_NAME    = &fill_record( "~" );
		$ROOM_DESCRIP = &fill_record( "~" );

		if( $WORLD_STATEMENTS % 5 == 0 ) {
			print "Parsing room number [$ROOM_NUMBER] which is [$ROOM_NAME]                             \n";
		}

		print OUTFILE "#$THIS_ROOM\n$ROOM_NAME\n$ROOM_DESCRIP\n";

		$_ = <STDIN>;
		$_ = &sum_bitfields( $_, %valid_room_flags );

		( $ZONE, $FLAGS, $TYPE ) = /(\d+)\s+(\d+)\s+(\d+)/;
		$FLAGS &= $ROOM_FLAG_MAX;
		print OUTFILE "$NEW_ZONE_ID $FLAGS $TYPE\n";

		if( $FLAGS & $ROOM_DEATH ){ print "\n$ROOM_NAME [$THIS_ROOM] is flagged as a DT.\n"; }

		$ROOM_COMPLETE = 0; $LINE_NEEDED = 1;
		while( $ROOM_COMPLETE == 0 ){

			if( $LINE_NEEDED ){ $_ = <STDIN>; }
			$LINE_NEEDED = 1;

			if( /^S/ ){ $ROOM_COMPLETE = 1; print OUTFILE "S\n"; }

			elsif( /^D/ ){
				print OUTFILE $_; chop( $THIS_EXIT = $_ );

				$EXIT_DESCRIP = &fill_record( "~" );
				$EXIT_KWORDS  = &fill_record( "~" );
				print OUTFILE "$EXIT_DESCRIP\n$EXIT_KWORDS\n";

				$_ = <STDIN>;
				( $DFLAG, $KEY_NUM, $TO_ROOM ) = /(\S+)\s+(\S+)\s+(\S+)/;

                                if( $KEY_NUM > 0 ){ $KEY_NUM = &adjust_id( "Door ID", $KEY_NUM ); }

				$TO_ROOM = &adjust_id( "Door Exit", $TO_ROOM );

				print OUTFILE "$DFLAG $KEY_NUM $TO_ROOM\n";

				$_ = <STDIN>;
				if( /^E/ ){
					$EXIT_NAME    = &fill_record( "~" );
					$EXIT_DESCRIP = &fill_record( "~" );
					print OUTFILE "E\n";
					print OUTFILE "$EXIT_NAME\n";
					print OUTFILE "$EXIT_DESCRIP\n";
				}
				else{ $LINE_NEEDED = 0; }
			}
			elsif( /^E/ ){
				print OUTFILE $_;
				$EXTRA_KWORDS = &fill_record( "~" );
				$EXTRA_DESCRIP = &fill_record( "~" );
				print OUTFILE "$EXTRA_KWORDS\n$EXTRA_DESCRIP\n";
			}
		}

	} # while

ROOMS_COMPLETE:
	print "\nWorld parsed with $WORLD_STATEMENTS rooms accepted (last created was $THIS_ROOM).\n";

} # parse_world

#
# Zone Parser
#
sub parse_zone{

	local( $ZONE_STATEMENTS ) = 0;

	print "Parsing the zone ... ";

	print OUTFILE "#$NEW_ZONE_ID\n";
	print OUTFILE "$ZONE_NAME~\n";
	print OUTFILE "$ZONE_TOP $ZONE_FREQ 2\n*\n";

	while(( $_ = <STDIN> ) && ( $OUTPUT_ACTIVE == 1 )) {

		if( /^\s*\*/ ){ print OUTFILE $_; }

		elsif( /^\s*M\s+\d\s+\d+\s+\d+\s+\d+\.*/ ){
			( $ZTYPE, $FLAG, $MOB, $MAX, $ROOM, $CMT ) = /(\M)\s+(\S+)\s+(\S+)\s+(\S+)\s+(\S+)(.*)/;
			$MOB  = &adjust_id( "Zone M Mob",  $MOB );
			$ROOM = &adjust_id( "Zone M Room", $ROOM );
			print OUTFILE "M $FLAG $MOB $MAX $ROOM $CMT\n";
			$ZONE_STATEMENTS += 1;
		}
		elsif( /^\s*O\s+\d\s+\d+\s+\d+\s+\d+\.*/ ){
			( $ZTYPE, $FLAG, $OBJ, $MAX, $ROOM, $CMT ) = /(\O)\s+(\S+)\s+(\S+)\s+(\S+)\s+(\S+)(.*)/;
			$OBJ  = &adjust_id( "Zone O Mob",  $OBJ );
			$ROOM = &adjust_id( "Zone O Room", $ROOM );
			print OUTFILE "O $FLAG $OBJ $MAX $ROOM $CMT\n";
			$ZONE_STATEMENTS += 1;
		}
		elsif( /^\s*G\s+\d\s+\d+\s+\d+\.*/ ){
			( $ZTYPE, $FLAG, $OBJ, $MAX, $CMT )  = /(\G)\s+(\S+)\s+(\S+)\s+(\S+)(.*)/;
			$OBJ  = &adjust_id( "Zone G Obj", $OBJ );
			print OUTFILE "G $FLAG $OBJ $MAX $CMT\n";
			$ZONE_STATEMENTS += 1;
		}
		elsif( /^\s*E\s+\d\s+\d+\s+\d+\s+\d+\.*/ ){
			( $ZTYPE, $FLAG, $OBJ, $MAX, $POS, $CMT ) = /(\E)\s+(\S+)\s+(\S+)\s+(\S+)\s+(\S+)(.*)/;
			$OBJ  = &adjust_id( "Zone E Ojb", $OBJ );
			print OUTFILE "E $FLAG $OBJ $MAX $POS $CMT\n";
			$ZONE_STATEMENTS += 1;
		}
		elsif( /^\s*P\s+\d\s+\d+\s+\d+\s+\d+\.*/ ){
			( $ZTYPE, $FLAG, $OBJ1, $MAX, $OBJ2, $CMT )= /(\P)\s+(\S+)\s+(\S+)\s+(\S+)\s+(\S+)(.*)/;
			$OBJ1 = &adjust_id( "Zone P Obj1", $OBJ1 );
			$OBJ2 = &adjust_id( "Zone P Obj2", $OBJ2 );
			print OUTFILE "P $FLAG $OBJ1 $MAX $OBJ2 $CMT\n";
			$ZONE_STATEMENTS += 1;
		}
		elsif( /^\s*D\s+\d\s+\d+\s+\d+\s+\d\.*/ ){
			( $ZTYPE, $FLAG, $ROOM, $EXIT, $STATE, $CMT )  = /(\D)\s+(\S+)\s+(\S+)\s+(\S+)\s+(\S+)(.*)/;
			$ROOM = &adjust_id( "Zone D Room", $ROOM );
			print OUTFILE "D $FLAG $ROOM $EXIT $STATE $CMT\n";
			$ZONE_STATEMENTS += 1;
		}
		elsif( /^\s*S\n/ ){
			print OUTFILE $_;
			print OUTFILE $NEW_EOF;
                        close $OUTFILE;
                        $OUTPUT_ACTIVE = 0;
			$CURRENT_TYP   = NONE_ACTIVE;
		}
		elsif( /^\s*R/ ){ print OUTFILE "* $_"; }

	} # while

	print " parsing complete with $ZONE_STATEMENTS statements accepted (top=$ZONE_TOP:freq=$ZONE_FREQ).\n";

} # parse_zone

