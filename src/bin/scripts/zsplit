#!/usr/local/bin/perl
#
# Mob flags
#
$MOB_SPEC	= (2 **  0);	$MOB_SENTINEL	= (2 **  1);	$MOB_SCAVENGER	= (2 **  2);
$MOB_ISNPC	= (2 **  3);	$MOB_NICE_THIEF	= (2 **  4);	$MOB_AGGRESSIVE	= (2 **  5);
$MOB_STAY_ZONE	= (2 **  6);	$MOB_WIMPY	= (2 **  7);	$MOB_AGGR_EVIL	= (2 **  8);
$MOB_AGGR_GOOD	= (2 **  9);	$MOB_AGGR_NEUT	= (2 ** 10);	$MOB_MEMORY	= (2 ** 11);
$MOB_BITS_MAX	= 12;		$MOB_FLAG_MAX   = ( $MOB_BITS_MAX ** 2 ) - 1;
#
# Affect Flags
#
$AFF_BLIND	= (2 **  0);	$AFF_INVISIBLE	= (2 **  1);	$AFF_DET_ALIGN	= (2 **  2);
$AFF_DET_INV	= (2 **  3);	$AFF_DET_MAGIC	= (2 **  4);	$AFF_SENSE_LIFE	= (2 **  5);
$AFF_WATERWALK	= (2 **  6);	$AFF_SANCTUARY	= (2 **  7);	$AFF_GROUP	= (2 **  8);
$AFF_CURSE	= (2 **  9);	$AFF_INFRARED	= (2 ** 10);	$AFF_POISON	= (2 ** 11);
$AFF_PROT_EVIL	= (2 ** 12);	$AFF_PROT_GOOD	= (2 ** 13);	$AFF_SLEEP	= (2 ** 14);
$AFF_NOTRACK	= (2 ** 15);	$AFF_UNUSED16	= (2 ** 16);	$AFF_UNUSED17	= (2 ** 17);
$AFF_SNEAK	= (2 ** 18);	$AFF_HIDE	= (2 ** 19);	$AFF_UNUSED20	= (2 ** 20);
$AFF_CHARM	= (2 ** 21);
$AFF_BITS_MAX	= 22;		$AFF_FLAG_MAX	= ( $AFF_BITS_MAX ** 2 ) - 1;
#
# Valid Mob Affects
#
%valid_mob_affects = (
	"DET_INV",	$AFF_DET_INV,
	"INFRA",	$AFF_INFRARED,
	"INVIS",	$AFF_INVISIBLE,
	"HIDE",		$AFF_HIDE,
	"SANC",		$AFF_SANCTUARY,
	"SANCT",	$AFF_SANCTUARY,
	"SANCTUARY",	$AFF_SANCTUARY,
	"SENSE",	$AFF_SENSE_LIFE,
	"SNEAK",	$AFF_SNEAK,
	"NULL",		0
);
#
# Room flags
#
$ROOM_DARK	= (2 **  0);	$ROOM_DEATH	= (2 **  1);	$ROOM_NO_MOB	= (2 **  2);
$ROOM_INDOORS	= (2 **  3);	$ROOM_LAWFULL	= (2 **  4);	$ROOM_NEUTRAL	= (2 **  5);
$ROOM_CHAOTIC	= (2 **  6);	$ROOM_NO_MAGIC	= (2 **  7);	$ROOM_TUNNEL	= (2 **  8);
$ROOM_PRIVATE	= (2 **  9);	$ROOM_GODROOM	= (2 ** 10);	$ROOM_BFS	= (2 ** 11);
$ROOM_BITS_MAX	= 12;		$ROOM_FLAG_MAX	= ( $ROOM_BITS_MAX ** 2 ) - 1;
#
# Valid Room Flags
#
%valid_room_flags = (
	"DARK",		$ROOM_DARK,
	"DT",		$ROOM_DEATH,
	"DEATH",	$ROOM_DEATH,
	"NO_MOB",	$ROOM_NO_MOB,
	"GOD_ROOM",	$ROOM_GODROOM,
	"NO_MAGIC",	$ROOM_NO_MAGIC,
	"PRIVATE",	$ROOM_PRIVATE,
	"NULL",		0
);

$NONE_ACTIVE	= 0;
$MOB_ACTIVE	= 1;	# Mobs are being parsed.
$OBJ_ACTIVE	= 2;	# Objects are being parsed.
$SHP_ACTIVE	= 3;	# A shop is being parsed.
$SPE_ACTIVE	= 4;	# Specials are being parsed.
$WLD_ACTIVE	= 5;	# Rooms are being parsed.
$ZON_ACTIVE	= 6;	# The zone file is being parsed.
$NUL_ACTIVE	= 999;	# This should never happen.

%string_to_ext  = (
		'#MOB',		'mob',
		'#OBJ',		'obj',
		'#SHO',		'shp',
		'#SPE',		'spc',
		'#ROO',		'wld',
		'#RES',		'zon',
		'#NUL',		'nul'
);

%string_to_typ  = (
		'#MOB',		$MOB_ACTIVE,
		'#OBJ',		$OBJ_ACTIVE,
		'#SHO',		$SHP_ACTIVE,
		'#SPE',		$SPE_ACTIVE,
		'#ROO',		$WLD_ACTIVE,
		'#RES',		$ZON_ACTIVE,
		'#NUL',		$NUL_ACTIVE
);

$CURRENT_TYP    = 0;
$EOF_STR	= "#0";
$NEW_EOF	= "#99999\n\$~\n";
$NEW_ZONE_ID	= "XX";
$OLD_ZONE_ID    = -1;
$OUTPUT_ACTIVE	= 0;

$ZONE_FREQ	= 45;
$ZONE_NAME	= "I NEED A NAME";
$ZONE_DIFF_MAX	= 0;

&parse_command_line();

if( !$ZONE_TOP ){ $ZONE_TOP = ( $NEW_ZONE_ID + $ZONE_DIFF_MAX ) . "99"; }

while(<>){

	if( $string_to_ext{ substr( $_, 0, 4 ) } ){
		chop;
		if( $OUTPUT_ACTIVE ){
			print OUTFILE $NEW_EOF;
			close $OUTFILE;
			$OUTPUT_ACTIVE = 0;
		}
		$EXT = $string_to_ext{ substr( $_, 0, 4 ) };
		$CURRENT_TYP = $string_to_typ{ substr( $_, 0, 4 ) };
		open( OUTFILE, "> $NEW_ZONE_ID.$EXT" ) || die "Cannot open $NEW_ZONE_ID.$EXT file: $!";
		print "Creating $NEW_ZONE_ID.$EXT ... \n";
		$OUTPUT_ACTIVE = 1;
	}

	elsif( $OUTPUT_ACTIVE ){
		if(    $CURRENT_TYP == $ZON_ACTIVE ){ &parse_zone(); }
		elsif( $CURRENT_TYP == $WLD_ACTIVE ){ &parse_world(); }
#		elsif( $CURRENT_TYP == $OBJ_ACTIVE ){ &parse_objects(); }
#		elsif( $CURRENT_TYP == $MOB_ACTIVE ){ &parse_mobiles(); }

		elsif( /\|/ && ( $CURRENT_TYP == $OBJ_ACTIVE || $CURRENT_TYP == $MOB_ACTIVE )){
			$_ = &sum_bitfields( $_, %valid_mob_affects );
			print OUTFILE "$_\n";
		}

		elsif( /^#0|^#99999/ ){
			if( $OUTPUT_ACTIVE ){
				print OUTFILE $NEW_EOF;
				close $OUTFILE;
				$OUTPUT_ACTIVE = 0;
			}
		}

		elsif( /^#/ ){
			( $NUM_ID ) = /^#(\S+)/;
			$NEW_ID = &adjust_id( "Main Loop", $NUM_ID );
			print OUTFILE "#$NEW_ID\n";
		}

		else{ print OUTFILE $_; }
	}
}

if( $OUTPUT_ACTIVE ){ close OUTFILE; }
exit(0);

#
# Fill Record
#
sub fill_record{

	local( $DELIMITTER ) = @_;

	$SCRATCH = $CHAR_IN = "";

	while( $CHAR_IN NE $DELIMITTER ){
		$CHAR_IN = getc;
		$SCRATCH .= $CHAR_IN;
	}

        while( getc NE $/ ){}; # Eat the trailing garbage upto and including the \n.

	return( $SCRATCH );

} # fill_record

#
# Command Line Parser
#
sub parse_command_line{

        $file_arg_not_found  = 1;
        $the_user_needs_help = 0;

        while( $file_arg_not_found && ( $_ = shift( @ARGV ))){
                if(     /^-z(one)?$/o       	) { $NEW_ZONE_ID    = shift( @ARGV ); }
		elsif(  /^-d(iff)?$/o		) { $ZONE_DIFF_MAX  = shift( @ARGV ); }
                elsif(  /^-o(ld)?$/o            ) { $OLD_ZONE_ID    = shift( @ARGV ); }
                elsif(  /^-n(ame)?$/o           ) { $ZONE_NAME      = shift( @ARGV ); }
                elsif(  /^-t(op)?$/o            ) { $ZONE_TOP       = shift( @ARGV ); }
                elsif(  /^-f(req)?$/o           ) { $ZONE_FREQ      = shift( @ARGV ); }
                elsif(  /^-h(elp)?$/o           ) { $the_user_needs_help        = 1; }
                elsif(  /^-d(ebug)?$/o          ) { $debug                      = 1; }
                elsif(  /^-v(erbose)?$/o        ) { $VERBOSE                    = 1; }
                elsif(  -f                      ) { $file_arg_not_found         = 0; unshift( @ARGV, $_ ); }
                else{                               $the_user_needs_help        = 1; };
        }
        
        if( $the_user_needs_help ){
                print "Usage: flt [-options] <filter_file>\n";
                print "where options can be:\n";
                print " -diff  = The maximum difference to expect from old to new zones\n";
                print " -freq  = How often to reset the zone\n";
                print " -name  = The name of the area for the zone file\n";
                print " -old   = The old zone id of the area\n";
                print " -top   = The top room in the zone\n";
                print " -zone  = The new zone id\n";
                exit(0);
        }

}#  parse_command_line


#
# Adjust IDs
#
sub adjust_id {

	local( $ID_TYPE, $ID_IN ) = @_;
	local( $ZONE, $ZDIFF, $OFFSET, $ID_OUT ) = 0;

	( $ZONE, $OFFSET ) = $ID_IN =~ /(\S+)(\S\S)/;

	if( $OLD_ZONE_ID < 0 ){ $OLD_ZONE_ID = $ZONE; }

	$ZDIFF = $ZONE - $OLD_ZONE_ID;
	if(( $ZDIFF < 0 ) || ( $ZDIFF > $ZONE_DIFF_MAX )){
		print "\n* * Possible problem with type $ID_TYPE ID $ID_IN [$_]\n";
		$ID_OUT = $ID_IN;
	}
	else {	$ID_OUT = ( $NEW_ZONE_ID + $ZDIFF ) . $OFFSET; }

	if( $VERBOSE ){ print "Adjusted $ID_TYPE from $ID_IN to $ID_OUT.\n"; }

	return( $ID_OUT );

} # adjust_id

#
# Convert Mnemonics
#
sub convert_mnemonics {

	local( $STRING_IN, %VALID_MNEMONICS )  = @_;

	$NO_MNEMONIC = "";

	@ALL_FIELDS = split( ' ', $STRING_IN );

	foreach $FIELD ( @ALL_FIELDS ){
		if( $VALUE =~ /\D+/ ){
			if( $VALID_MNEMONICS{ $VALUE } ){ $BITFIELD += $VALID_MNEMONICS{ $VALUE }; }
			else{ print "***INVALID MNEMONIC [$VALUE]***\n"; }
		}
	}

	return( $NO_MNEMONIC );
}

#
# Sum Bitfields
#
sub sum_bitfields {

	local( $BITS_IN, %VALID_MNEMONICS )  = @_;

	$BIT_STRING = "";

	if( $BITS_IN =~ /\|/ ){

		@ALL_FIELDS = split( ' ', $BITS_IN );

		foreach $FIELD ( @ALL_FIELDS ){
			if( $FIELD =~ /\|/ ){
				@BITS = split( '\|', $FIELD );
				$BITFIELD = 0;
				foreach $VALUE ( @BITS ){
					if( $VALUE =~ /\D+/ ){
						if( $VALID_MNEMONICS{ $VALUE } ){ $BITFIELD += $VALID_MNEMONICS{ $VALUE }; }
						else{ print "***INVALID MNEMONIC [$VALUE]***\n"; }
					}
					else{ $BITFIELD += $VALUE; }
				}
				$BIT_STRING .= "$BITFIELD ";
			}
			else { $BIT_STRING .= "$FIELD "; }
		}
	}
	else{ $BIT_STRING = $BITS_IN; }

	return( $BIT_STRING );

} # sum_bitfields

