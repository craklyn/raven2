#!/usr/local/bin/perl

sub load_and_burst_zones {
	$ZONE_IDX	= 0;
	$NEED_ID	= 1;
	$NEED_NAME	= 0;
	$NEED_TOP	= 0;

	open( ZONE_IN, "< tinyworld.zon" ) || die 'Cannot open the zone file';
	if( ! -d "areas" ){ mkdir ( "areas", 0755 ) || die 'Cannot create areas output dir'; }

	while(<ZONE_IN>){

		if( /^#/ ){	# Find the Zone def
			print ZONE_OUT "#0\n";
			close( ZONE_OUT );
			$NEED_NAME = 1;
			($ZONE_ID) = /^#(\d+)/;
		}

		elsif( $NEED_NAME ){
			$NEED_NAME = 0; $NEED_TOP  = 1;
			chop; chop;
			tr/A-Z/a-z/;
			s/[\/]/ /g;
			s/[',.]//g;
			@words = split( /\W*\s+\W*/, $_);
			$ZONE_NAME = "";
			foreach $word (@words) {
				($first_char, $word ) = $word =~ /(\S)(\S+)/;
				$first_char =~ tr/[a-z]/[A-Z]/;
				$ZONE_NAME .= $first_char . $word . '_';
			}
			chop $ZONE_NAME;
		}

		elsif( $NEED_TOP ){
			$NEED_TOP = 0;
			chop;
			($ZONE_TOP, $ZONE_REPOP, $ZONE_TYPE) = /(\S+)\s+(\S+)\s+(\S+)/;
			@ZONES[ $ZONE_IDX++ ] = join( ':', $ZONE_ID, $ZONE_TOP, $ZONE_NAME );
			print "Bursting zone $ZONE_ID is [$ZONE_NAME] with a top room of [$ZONE_TOP]\n";
			open( ZONE_OUT, "> areas/$ZONE_NAME.are.txt" ) || die 'Cannot create area text file';
			print ZONE_OUT "#RES\n";
			print ZONE_OUT "#$ZONE_ID\n";
			print ZONE_OUT "$ZONE_NAME~\n";
			print ZONE_OUT "$ZONE_TOP $ZONE_REPOP $ZONE_TYPE\n";
		}
		else{
			print ZONE_OUT;
		}

	} # while

} # load_and_burst_zones



sub load_and_burst_file {

	local( $BURST_NAME, $BURST_AREA_ID ) = @_;
	$BURST_ID = 0;

	print "--------------------------------------------------------\n";
	print "----- Bursting: $BURST_NAME\n";
	print "--------------------------------------------------------\n";
	open( BURST_IN, "< $BURST_NAME" ) || die 'Cannot open $BURST_NAME.';

	foreach $ZONE_ENTRY ( @ZONES  ) {
		( $ZONE_ID, $ZONE_TOP, $ZONE_NAME ) = split( ':', $ZONE_ENTRY );

		print "Building from zone $ZONE_NAME ($BURST_AREA_ID).\n";

		open( BURST_OUT, ">> areas/$ZONE_NAME.are.txt" ) || die 'Cannot open area file = areas/$ZONE_NAME.are.txt.';

		print BURST_OUT "\n\n$BURST_AREA_ID\n";

		if( $BURST_ID ){ print BURST_OUT "#$BURST_ID\n"; }

		while( !eof( BURST_IN ) && $BURST_ID <= $ZONE_TOP ){
			$_ = <BURST_IN>;
			if( /^#/ ){
				($BURST_ID) = /^#(\d+)/;
			}
			if( $BURST_ID <= $ZONE_TOP ){ print BURST_OUT; }
		}
		print BURST_OUT "#0\n\$~\n";
		close( BURST_OUT );

	} # foreach

	close( BURST_IN );

} # load_and_burst_world


#
# Main
#

&load_and_burst_zones();

&load_and_burst_file( "tinyworld.wld", "#ROO" );
&load_and_burst_file( "tinyworld.obj", "#OBJ" );
&load_and_burst_file( "tinyworld.mob", "#MOB" );

print "All Done\n";

