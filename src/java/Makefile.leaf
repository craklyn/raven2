#
# The JAVAROOT variable must be set to point to the top of the solipsys
# source tree or none of this will work.
#
# Change TEMPLATEROOT to NEWPROJECTROOT just like the main Makefile
#
ifneq "$(TEMPLATEROOT)" ""

JAVAROOT = $(TEMPLATEROOT)/src/java

include $(JAVAROOT)/Makefile

else
#
# JAVAROOT is not set so we need to let the user know what to do.
#
all bare clean distclean help here quietly::
	@echo "  TEMPLATEROOT is not properly set."; echo ""
endif
