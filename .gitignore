# Object and Library files
*.o
*.a
*.so
*.lo
*.la

# Dependency files (Hidden .d files generated by the compiler)
.*.d

# Temporary and backup files
*~
*.bak
*.tmp
*.old
temp.out
gdb.tmp

# Logs
syslog
syslog.*
log/*
!log/.gitkeep

# OS specific
.DS_Store

# Version Control
.svn/

# Archives
*.tar

# Binaries
bin/*
!bin/.gitkeep
src/bin/moon
src/bin/autowiz
# ... add other binaries as needed

# MUD Data (often better managed separately, but ignoring common dynamic files)
sys/plrobjs/*
sys/plrtext/*
sys/plrvars/*
sys/tally/*
sys/house/*
sys/lockers/*
sys/corpse/*
sys/corpses/*

# Secrets (we will use secrets.h.example as a template)
src/include/general/secrets.h
