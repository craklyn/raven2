#29839
QP PIGLET LOAD POTION~
1 c 100
smash~
if %arg% == potion
  eval roomid %actor.room%
  eval roomname %roomid.name%
  %send% %actor% You SMASH the potion! Much sexy. Such hero. Wow.
  %echoaround% %actor% &09%actor.name%&00 smashes &12a piglet potion&00! What a MESS!
  Wait 3 sec
  %echo% &09%actor.name%&00 has spawned &12piglets&00 at %roomname%!!&00
  Wait 2 sec
  %load% mob 29880
  %teleport% piglet 29804
  %load% mob 29880
  %teleport% piglet 29805
  %load% mob 29881
  %teleport% piglet 29806
  wait 1 sec
  %echo% &12Three &12piglets &10- POP -&12 into existence. They look confused!&00
  Wait 1 sec
  %echo% The &12piglets&00 squeal and hastily utter the words '&07zri'ta n'u stivek&00' together.
  Wait 1 sec
  %echo% The &12piglets&00 are sucked into a raging vortex of energy!
  Wait 1
  %purge% %self%
end
~
#29840
Tough Zone Piglet 15 QP~
0 f 100
~
eval master %actor% 
eval more 1
while %more%
  if %master.master% && (%master.is_npc% || %master.is_grouped%)
    eval master %master.master%
  else
    eval more 0
  end
done
if %master.is_npc% == 0 && %master.room% == %actor.room% && %master.is_grouped%
  %send% %master% &13You have earned 15 quest points!&00
  nop %master.qp(15)%
end
eval follower 0
meta ch master.follower(%follower%)
while %ch%
  if %ch.is_npc% == 0 && %ch.room% == %actor.room% && %ch.is_grouped%
    %send% %ch% &13You have earned 15 quest points!&00
    nop %ch.qp(15)%
  end
  eval follower %follower% + 1
  meta ch master.follower(%follower%)
done
~
#29841
Easy Zone Piglet 5 QP~
0 f 100
~
eval master %actor% 
eval more 1
while %more%
  if %master.master% && (%master.is_npc% || %master.is_grouped%)
    eval master %master.master%
  else
    eval more 0
  end
done
if %master.is_npc% == 0 && %master.room% == %actor.room% && %master.is_grouped%
  %send% %master% &13You have earned 5 quest points!&00
  nop %master.qp(5)%
end
eval follower 0
meta ch master.follower(%follower%)
while %ch%
  if %ch.is_npc% == 0 && %ch.room% == %actor.room% && %ch.is_grouped%
    %send% %ch% &13You have earned 5 quest points!&00
    nop %ch.qp(5)%
  end
  eval follower %follower% + 1
  meta ch master.follower(%follower%)
done
~
#29842
Piglet Teleport~
0 k 100
60~
eval target %random.char%
if %target.is npc% || %target.level% >50
  halt
else
  if %target%
    %echoaround% &09%actor.name%&00 slips in some dung and slides right off your screen!
    %teleport% %target% 3003
    mat 3003 %send% %actor% You slipped in some dung and somehow ended up here!
  end
~
