#24801
UW maze randomizer~
2 f 100
~
* Maze Randomizer for room 24801
switch %random.4%    
case 1
* Purge all the exits first
wdoor %self.vnum% east room 24802^M      
wdoor %self.vnum% north room 24809^M
wdoor %self.vnum% south room 24809^M      
wdoor %self.vnum% west room 24802^M
break
case 2
wdoor %self.vnum% east room 24809^M
wdoor %self.vnum% north room 24802^M
wdoor %self.vnum% south room 24809^M      
wdoor %self.vnum% west room 24809^M
break
case 3
wdoor %self.vnum% east room 24809^M
wdoor %self.vnum% north room 24809^M
wdoor %self.vnum% south room 24802^M      
wdoor %self.vnum% west room 24809^M
break
case 4
wdoor %self.vnum% east room 24809^M
wdoor %self.vnum% north room 24809^M
wdoor %self.vnum% south room 24809^M      
wdoor %self.vnum% west room 24802^M
break
~
