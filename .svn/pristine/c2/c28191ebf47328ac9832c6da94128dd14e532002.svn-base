#!/bin/csh

# Shotgun approach to doing things.

  /bin/rm log/syslog.1
  /bin/mv log/syslog.2 log/syslog.1
  /bin/mv log/syslog.3 log/syslog.2
  /bin/mv log/syslog.4 log/syslog.3
  /bin/mv log/syslog.5 log/syslog.4
  /bin/mv log/syslog.6 log/syslog.5
  /bin/mv syslog       log/syslog.6
  /bin/touch syslog

  cd log

  fgrep "self-delete" syslog.6 >> delete
  tail -n 300 delete         >> delete.tmp
  mv delete.tmp delete

  fgrep "ADVANCE"        syslog.6 >> advances
  tail -n 500 advances >> advances.tmp
  mv advances.tmp advances

  fgrep "LOAD"           syslog.6 >> loads
  tail -n 300 loads >> loads.tmp
  mv loads.tmp loads

  fgrep "META"           syslog.6 >> metaphys
  tail -n 500 metaphys >> metaphys.tmp
  mv metaphys.tmp metaphys

  fgrep "Shunned"        syslog.6 >> shunnedIO
  tail -n 1000 shunnedIO >> shunnedIO.tmp
  mv shunnedIO.tmp shunnedIO

  fgrep "advanced"       syslog.6 >> levels
  tail -n 500 levels >> levels.tmp
  mv levels.tmp levels

  fgrep "equipment lost" syslog.6 >> rentgone
  tail -n 300 rentgone >> rentgone.tmp
  mv rentgone.tmp rentgone

  fgrep "has rented" syslog.6 >> rentout
  tail -n 600 rentout >> rentout.tmp
  mv rentout.tmp rentout

  fgrep "usage"          syslog.6 >> usage
  tail -n 300 usage >> usage.tmp
  mv usage.tmp usage

  fgrep "new player"     syslog.6 >> newplayers
  tail -n 300 newplayers >> newplayers.tmp
  mv newplayers.tmp newplayers

  fgrep "SYSERR"         syslog.6 >> errors
  tail -n 300 errors >> errors.tmp
  mv errors.tmp errors

  fgrep "OLCERR"         syslog.6 >> olcerrors
  tail -n 300 olcerrors >> olcerrors.tmp
  mv olcerrors.tmp olcerrors

  fgrep "OLC"            syslog.6 >> olcmods
  tail -n 500 olcmods >> olcmods.tmp
  mv olcmods.tmp olcmods

  fgrep "(GC)"           syslog.6 >> godcmds
  tail -n 500 godcmds >> godcmds.tmp
  mv godcmds.tmp godcmds

  fgrep "Bad PW"         syslog.6 >> badpws
  tail -n 300 badpws >> badpws.tmp
  mv badpws.tmp badpws

  fgrep "Prayer"         syslog.6 >> prayers
  tail -n 300 prayers >> prayers.tmp
  mv prayers.tmp prayers

  fgrep "OBJ" syslog.6 >> objecterrors
  tail -n 500 objecterrors >> objecterrors.tmp
  mv objecterrors.tmp objecterrors

  fgrep "death trap"    syslog.6 >> dtraps
  tail -n 300 dtraps >> dtraps.tmp
  mv dtraps.tmp dtraps

  fgrep "LAST COMMAND"     syslog.6 >> crashcmds
  tail -n 500 crashcmds >> crashcmds.tmp
  mv crashcmds.tmp crashcmds

  fgrep "Bad PW"         syslog.6 >> badpws
  tail -n 300 badpws >>  badpws.tmp
  mv badpws.tmp badpws

  fgrep "killed"         syslog.6 >> deaths
  tail -n 300 deaths >>  deaths.tmp
  mv deaths.tmp deaths

  fgrep "Running"          syslog.6 >> reboots
  tail -n 400 reboots >>   reboots.tmp
  mv reboots.tmp reboots

