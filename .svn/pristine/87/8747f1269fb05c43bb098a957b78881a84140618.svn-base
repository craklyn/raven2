#!/bin/csh

# Make sure all the file perms are locked down.
#
/bin/chmod -R o-rwx $HOME

# Make sure all of the correct dirs are touched to update access times.
#
cd $RAVEN_ROOT/sys
/bin/touch plrobjs plrtext world

# Remove the backups that are more than 21 days old
#
find ~/archives/sysarc -name \* -mtime +21 -print -exec rm -rf {} \;

# Purge the old files
#
cd $RAVEN_ROOT/sys/plrobjs

find . -name \*.BAK -mtime +7 -print -exec rm -f {} \;

foreach fn( A-E F-J K-O P-T U-Z )
    find $fn -name \* -mtime +180 -print -exec rm -f {} \;
end

# Do the backup
#
cd $RAVEN_ROOT/sys
setenv TARFILE sysarc-`$RAVEN_ROOT/bin/datestr.pl`.tar.gz
setenv ARCFILES "X.tar etc/players plrobjs world/mob world/obj world/rnd world/shp world/wld world/zon"

find plrobjs -name \* -mtime +4 | sort > X.tar
find world   -name \* -mtime +4 | sort >> X.tar

tar czXf X.tar $TARFILE $ARCFILES

chmod 0400 $TARFILE
/bin/rm X.tar

mv $TARFILE ~/archives/sysarc
