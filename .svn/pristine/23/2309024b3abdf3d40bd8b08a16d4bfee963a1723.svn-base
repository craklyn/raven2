#!/usr/bin/perl

$TARGET_IP = "24.231";

@SUSPECTS = ( "Phreak", "Starlight", "Aries" );
$PRINTED  = 0;
$NAMECHK  = 0;

$TOTAL_LINES   = 0;
$TOTAL_PRINTED = 0;
$TOTAL_SKIPPED = 0;

while(<>)
{
  ($TIMESTAMP,$NAME,$IPADDR) = /(\S+\s+\S+\s+\S+\s+\S+)\s+\:\:\s+(\S+)\s+\[(\S+)\].*/;

  if( /$TARGET_IP/ )
  {
    if( /has connected./ )
    {
      push @SUSPECTS, $NAME;
      $NAMECHK = 1;
    }
  }

  if( $NAMECHK )
  {
    $PRINTED = 0;
    foreach $NAME (@SUSPECTS)
    {
      if( /$NAME/ && ( $PRINTED == 0 ))
      {
        print;
        $PRINTED = 1;
      }
    }
  }

  if( $PRINTED )
  {
    $TOTAL_PRINTED += 1;
  }
  else
  {
    $TOTAL_SKIPPED += 1;
  }

}

print '-'x80, "\n";
print "  Total Lines: $TOTAL_LINES\n";
print "      Printed: $TOTAL_PRINTED\n";
print "      Skipped: $TOTAL_SKIPPED\n";
print '-'x80, "\n";

