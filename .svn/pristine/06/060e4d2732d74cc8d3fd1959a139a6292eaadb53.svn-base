#!/usr/bin/perl

$RAVENROOT  = "/home/raven/moon-root";
$RAVENBIN   = "$RAVENROOT/bin";
$BOOTSCRIPT = "$RAVENBIN/bootraven &";
$SYSLOG     = "$RAVENROOT/syslog";

$FAGEPL     = "$RAVENBIN/fage.pl";
$TOUCHIT    = "/bin/touch $RAVENROOT/.lastcron";
$MAILRECIP  = "digger\@ravenmud.betterbox.net";

# 
# Check to see if the mud process is running...
#
`/bin/rm -f /tmp/.ravenproc; ps -x > /tmp/.ravenproc`;

open (FILE, "/tmp/.ravenproc");

$auto_found = 0;
$moon_found = 0;

while (<FILE>)
{
  if (m!autorun!)
  {
      $auto_found += 1;
  }
  if (m!moon -q $PORT!)
  {
      $moon_found += 1;
  }
}

unlink ("/tmp/.ravenproc");

if( ($moon_found == 0) && ($auto_found == 0) )
{
  `echo "No autorun or moon" | mail $MAILRECIP -s "Error: Raven"`;
  system( $BOOTSCRIPT );
}

else 
{
  if ( ( $moon_found > 0 ) && ( $auto_found == 0) )
  {
    #
    # Found the mud process but no autorun :-(
    #
    # print "No autorun.\n";
    `echo "No autorun" | mail $MAILRECIP -s "Warn: Raven"`;
  }
  else
  {
    $lastUpdate = `$FAGEPL $SYSLOG`;
    if( $lastUpdate > 360 )
    {
      `echo "The MUD Is Hung" | mail $MAILRECIP -s "ERROR: RavenMUD"`;
    }
    else
    {
      print "everything Ok [$lastUpdate]\n";
    }
  }
}

system( $TOUCHIT );

