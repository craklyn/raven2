#!/bin/csh
#
cd $RAVEN_ROOT/sys/etc

set FLAST = "`$RAVEN_ROOT/bin/fage.pl $RAVEN_ROOT/sys/etc/.lastpurge 43200`"

if( $FLAST != "" ) then

  touch $RAVEN_ROOT/sys/etc/.lastpurge

  echo `date` >> ../../log/DELETED
  ../../bin/purgeplay players >> ../../log/DELETED

  if (! -z players.new) then
    mv players players.old
    mv players.new players
    gzip -f players.old
  endif

endif

