#!/usr/local/bin/perl

%string_to_ext  = (
		'#MOB',		'mob',
		'#OBJ',		'obj',
		'#SHO',		'shp',
		'#SPE',		'spc',
		'#ROO',		'wld',
		'#RES',		'zon',
		'#NUL',		'nul'
);

%ext_to_string	= (
		'mob',		'#MOB',
		'obj',		'#OBJ',
		'shp',		'#SHO',
		'spc',		'#SPE',
		'wld',		'#ROO',
		'zon',		'#RES',
		'nul',		'#NUL'
);

$EOF_STRING	= "#99999";
$FILE_SEPARATOR	= "#0";
$ZONE_NAME	= "NoName";
$OUTPUT_ACTIVE	= 0;

&parse_command_line();


open( FILE_OUT, "> $ZONE_NAME.area.txt" );

while($FILE_NM = shift( @ARGV )){

	( $EXTENSION ) = $FILE_NM =~ /.*\.(\S+)/;
	$EXTENSION =~ tr/A-Z/a-z/;
	if( $ext_to_string{ $EXTENSION } ){
		open( FILE_IN, "< $FILE_NM" ) || die "$!: $FILE_NM";
		print FILE_OUT "$ext_to_string{ $EXTENSION }\n";
		while( <FILE_IN> ){ s///; print FILE_OUT "$_"; }
		close( FILE_IN );

		print FILE_OUT "$FILE_SEPARATOR\n\n\n";
	}

}

close FILE_OUT;
exit(0);


#
# Command Line Parser
#
sub parse_command_line{

        $file_arg_not_found  = 1;
        $the_user_needs_help = 0;

        while( $file_arg_not_found && ( $_ = shift( @ARGV ))){
                if   (  /^-n(ame)?$/o           ) { $ZONE_NAME      = shift( @ARGV ); }
                elsif(  /^-h(elp)?$/o           ) { $the_user_needs_help        = 1; }
                elsif(  /^-d(ebug)?$/o          ) { $debug                      = 1; }
                elsif(  /^-v(erbose)?$/o        ) { $VERBOSE                    = 1; }
                elsif(  -f                      ) { $file_arg_not_found         = 0; unshift( @ARGV, $_ ); }
                else{                               $the_user_needs_help        = 1; };
        }
        
        if( $the_user_needs_help ){
                print "Usage: flt [-options] <filter_file>\n";
                print "where options can be:\n";
                print " -name  = The name of the area for the zone file\n";
                exit(0);
        }

}#  parse_command_line


#
# Sum Bitfields
#
sub sum_bitfields {

	local( $BITS_IN )  = @_;

	$BIT_STRING = "";

	if( $BITS_IN =~ /\|/ ){

		@ALL_FIELDS = split( ' ', $BITS_IN );

		foreach $FIELD ( @ALL_FIELDS ){
			if( $FIELD =~ /\|/ ){
				@BITS = split( '\|', $FIELD );
				$BITFIELD = 0;
				foreach $VALUE ( @BITS ){ $BITFIELD += $VALUE; }
				$BIT_STRING .= "$BITFIELD ";
			}
			else {  $BIT_STRING .= "$FIELD "; }
		}
	}
	else{ $BIT_STRING = $BITS_IN; }

	return( $BIT_STRING );

} # sum_bitfields

